{
  "name": "@stockflow/desktop",
  "private": true,
  "version": "1.14.2",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm build:web && pnpm build:electron",
    "clean": "rimraf dist dist-electron node_modules/.tmp",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"pnpm build:electron && wait-on -t 60000 http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,usb,@serialport/bindings-cpp",
    "postinstall": "electron-rebuild -f -w better-sqlite3,usb,@serialport/bindings-cpp",
    "lint": "eslint .",
    "type-check": "tsc -b && tsc -p tsconfig.electron.json --noEmit",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:ipc": "tsx electron/__tests__/ipc.smoke.ts",
    "test:license": "tsx electron/__tests__/license.smoke.ts",
    "test:hardware": "tsx electron/__tests__/hardware.smoke.ts",
    "test:lan": "tsx electron/__tests__/lan.smoke.ts",
    "build:win": "node scripts/package.mjs --win --config electron-builder.win.yml",
    "build:mac": "node scripts/package.mjs --mac",
    "build:linux": "node scripts/package.mjs --linux",
    "build:all": "node scripts/package.mjs -mwl",
    "publish:win": "node scripts/package.mjs --win --publish=always --config electron-builder.win.yml",
    "publish:mac": "node scripts/package.mjs --mac --publish=always",
    "package:dry": "node scripts/package.mjs --mac --dir",
    "preview": "vite preview",
    "test:assistant": "tsx electron/__tests__/assistant.smoke.ts",
    "test:flowy-ia": "tsx electron/__tests__/flowy-ia.smoke.ts",
    "flowy:indice": "tsx scripts/generar-indice-flowy.ts",
    "flowy:conflictos": "tsx scripts/flowy-conflictos.ts",
    "test:consultas": "tsx electron/__tests__/consultas.smoke.ts",
    "test:kb": "node scripts/validate-kb.mjs",
    "test:flows": "tsx electron/__tests__/flows.smoke.ts",
    "test:demo": "tsx electron/__tests__/demo.smoke.ts",
    "test:onboarding": "tsx electron/__tests__/onboarding.smoke.ts",
    "test:fiscal": "tsx electron/__tests__/fiscal.smoke.ts",
    "test:fiscal-xml": "tsx electron/__tests__/fiscal-xml.smoke.ts",
    "test:fiscal-importes": "tsx electron/__tests__/fiscal-importes.smoke.ts",
    "test:arca": "tsx scripts/verificar-arca.ts",
    "test:catalogo": "tsx electron/__tests__/catalogo.smoke.ts",
    "test:devoluciones": "tsx electron/__tests__/devoluciones.smoke.ts",
    "test:backup": "tsx electron/__tests__/backup.smoke.ts",
    "test:seguridad-lan": "tsx electron/__tests__/seguridad-lan.smoke.ts",
    "test:pdv-caja": "tsx electron/__tests__/pdv-caja.smoke.ts",
    "test:vuelto": "tsx electron/__tests__/vuelto.smoke.ts",
    "test:facturas": "tsx electron/__tests__/facturas.smoke.ts",
    "test:facturas-parser": "tsx electron/__tests__/facturas-parser.smoke.ts",
    "test:facturas-reales": "tsx electron/__tests__/facturas-reales.smoke.ts",
    "test:facturas-servidor": "tsx electron/__tests__/facturas-servidor.smoke.ts",
    "test:facturas-compra": "tsx electron/__tests__/facturas-compra.smoke.ts",
    "test:facturas-sistema": "tsx electron/__tests__/facturas-sistema.smoke.ts",
    "test:facturas-paddle": "tsx electron/__tests__/facturas-paddle.smoke.ts",
    "test:facturas-asociador": "tsx electron/__tests__/facturas-asociador.smoke.ts",
    "test:ventanas": "tsx electron/__tests__/ventanas.smoke.ts",
    "test:contabilidad-listados": "tsx electron/__tests__/contabilidad-listados.smoke.ts",
    "test:fiscal-pv": "tsx electron/__tests__/fiscal-pv.smoke.ts",
    "test:ventas-enter": "tsx electron/__tests__/ventas-enter.smoke.ts",
    "test:devolucion-items": "tsx electron/__tests__/devolucion-items.smoke.ts",
    "test:imprimir-ticket": "tsx electron/__tests__/imprimir-ticket.smoke.ts",
    "test:direccion-servidor": "tsx electron/__tests__/direccion-servidor.smoke.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@serialport/parser-readline": "^12.0.0",
    "@tanstack/react-query": "^5.100.10",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.2.0",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.14.0",
    "node-forge": "^1.4.0",
    "onnxruntime-node": "1.30.0",
    "postcss": "^8.5.14",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^6",
    "recharts": "^3.8.1",
    "serialport": "^12.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3",
    "usb": "^2.14.0",
    "xlsx": "^0.18.5",
    "zod": "^3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@stockflow/core": "workspace:*",
    "@stockflow/db": "workspace:*",
    "@stockflow/shared": "workspace:*",
    "@types/archiver": "^6.0.3",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.3.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "png2icons": "^2.0.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^8.0.1"
  }
}
